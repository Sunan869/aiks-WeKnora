# ==================== Images ====================
WEKNORA_APP_IMAGE=aiks-weknora-app:team
WEKNORA_FRONTEND_IMAGE=aiks-weknora-frontend:team
WEKNORA_DOCREADER_IMAGE=aiks-weknora-docreader:team
WEKNORA_POSTGRES_IMAGE=paradedb/paradedb:v0.22.6-pg17
WEKNORA_REDIS_IMAGE=redis:7.0-alpine

WEKNORA_APP_CONTAINER_NAME=weknora-app
WEKNORA_FRONTEND_CONTAINER_NAME=weknora-frontend
WEKNORA_DOCREADER_CONTAINER_NAME=weknora-docreader
WEKNORA_POSTGRES_CONTAINER_NAME=weknora-postgres
WEKNORA_REDIS_CONTAINER_NAME=weknora-redis

# Shared with aiks-service collector.
AIKS_TEAM_NETWORK=aiks-team-network

# ==================== Ports ====================
WEKNORA_FRONTEND_BIND=0.0.0.0
WEKNORA_FRONTEND_PORT=80
# App is normally only exposed on loopback for debugging/reverse proxy.
WEKNORA_APP_BIND=127.0.0.1
WEKNORA_APP_PORT=8080

# ==================== Database / Redis ====================
DB_USER=postgres
DB_PASSWORD=
DB_NAME=WeKnora
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=stream:

# ==================== Security ====================
# start.sh generates the empty values below on first run and keeps them in .env.
JWT_SECRET=
SYSTEM_AES_KEY=
SYSTEM_SIGNING_KEY=

GIN_MODE=release
TZ=Asia/Shanghai
AUTO_MIGRATE=true
AUTO_RECOVER_DIRTY=true
DEFAULT_LOCALE=zh-CN
MAX_FILE_SIZE_MB=100

# ==================== Storage / retrieval ====================
STORAGE_TYPE=local
RETRIEVE_DRIVER=postgres
STREAM_MANAGER_TYPE=redis

# ==================== Workspace / RBAC ====================
WEKNORA_AUTH_DEFAULT_TENANT_MODE=create_personal
WEKNORA_TENANT_ENABLE_RBAC=true
WEKNORA_TENANT_SELF_SERVICE_CREATION_ENABLED=true
WEKNORA_TENANT_ENABLE_CROSS_TENANT_ACCESS=false
WEKNORA_TENANT_DEFAULT_STORAGE_QUOTA_GB=10
# Optional: bootstrap one system admin by email.
WEKNORA_BOOTSTRAP_SYSTEM_ADMIN_EMAIL=

# ==================== DingTalk ====================
# Keep disabled until the real DingTalk app values are filled.
DINGTALK_AUTH_ENABLE=false
DINGTALK_AUTH_PROVIDER_DISPLAY_NAME=钉钉
DINGTALK_AUTH_CLIENT_ID=
DINGTALK_AUTH_CLIENT_SECRET=
DINGTALK_AUTH_CORP_ID=

# Department -> WeKnora organization automatic membership.
# Requires DINGTALK_AUTH_CORP_ID and the JSON mapping below.
DINGTALK_AUTH_SYNC_DEPARTMENTS=false
# Example:
# DINGTALK_AUTH_DEPARTMENT_ORGANIZATION_MAPPINGS=[{"department_id":123456,"organization_id":"00000000-0000-0000-0000-000000000001","role":"viewer"},{"department_id":789012,"organization_id":"00000000-0000-0000-0000-000000000001","role":"editor"}]
DINGTALK_AUTH_DEPARTMENT_ORGANIZATION_MAPPINGS=

# ==================== Optional model defaults ====================
# Models can also be configured later in the WeKnora UI.
OLLAMA_OPTIONAL=true
OLLAMA_BASE_URL=http://host.docker.internal:11434

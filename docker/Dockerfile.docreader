# =========================
# 构建阶段（轻量化：仅文档解析 + 图片提取，无 OCR/VLM）
# =========================
FROM python:3.10.18-bookworm AS builder

ARG APT_MIRROR=""
ARG PYPI_MIRROR="https://mirrors.aliyun.com/pypi/simple"

# GitHub 国内代理
ARG GITHUB_PROXY_PRIMARY="https://githubproxy.cc/"
ARG GITHUB_PROXY_FALLBACK="https://ghfast.top/"

RUN if [ -n "$APT_MIRROR" ]; then \
    sed -i "s@http://deb.debian.org@${APT_MIRROR}@g" \
    /etc/apt/sources.list.d/debian.sources && \
    sed -i "s@http://security.debian.org@${APT_MIRROR}@g" \
    /etc/apt/sources.list.d/debian.sources; \
    fi

WORKDIR /app


# =========================
# 安装构建依赖
# =========================
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    libjpeg-dev \
    zlib1g-dev \
    libffi-dev \
    libgl1 \
    libglib2.0-0 \
    wget \
    antiword \
    curl \
    unzip \
    ca-certificates && \
    rm -rf /var/lib/apt/lists/*


# =========================
# 安装 protoc
#
# 优先：
# 1. packages 本地离线包
# 2. githubproxy.cc
# 3. ghfast.top
# 4. GitHub 官方
# =========================

ARG TARGETARCH

COPY packages/ /app/packages/

RUN ls -lah /app/packages/ || true


RUN set -eux; \
    \
    if [ -z "${TARGETARCH:-}" ]; then \
    case "$(uname -m)" in \
    "x86_64") \
    TARGETARCH="amd64" \
    ;; \
    "aarch64") \
    TARGETARCH="arm64" \
    ;; \
    "armv7l") \
    TARGETARCH="arm" \
    ;; \
    *) \
    echo "Unsupported architecture: $(uname -m)"; \
    exit 1 \
    ;; \
    esac; \
    echo "[自动检测] 架构: ${TARGETARCH}"; \
    else \
    echo "[BuildKit] 架构: ${TARGETARCH}"; \
    fi; \
    \
    case "${TARGETARCH}" in \
    "amd64") \
    PROTOC_ARCH="x86_64" \
    ;; \
    "arm64") \
    PROTOC_ARCH="aarch_64" \
    ;; \
    "arm") \
    PROTOC_ARCH="arm" \
    ;; \
    *) \
    echo "Unsupported architecture for protoc: ${TARGETARCH}"; \
    exit 1 \
    ;; \
    esac; \
    \
    PROTOC_VERSION="3.19.4"; \
    PROTOC_PACKAGE="protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip"; \
    PROTOC_LOCAL="/app/packages/${PROTOC_PACKAGE}"; \
    PROTOC_TMP="/tmp/${PROTOC_PACKAGE}"; \
    PROTOC_URL="https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/${PROTOC_PACKAGE}"; \
    \
    echo "protoc package: ${PROTOC_PACKAGE}"; \
    \
    if [ -f "${PROTOC_LOCAL}" ]; then \
    \
    echo "============================================"; \
    echo "发现本地 protoc 安装包"; \
    echo "${PROTOC_LOCAL}"; \
    echo "使用离线安装"; \
    echo "============================================"; \
    \
    cp "${PROTOC_LOCAL}" "${PROTOC_TMP}"; \
    else \
    \
    echo "============================================"; \
    echo "未发现本地 protoc 安装包"; \
    echo "开始从国内 GitHub 代理下载"; \
    echo "============================================"; \
    \
    curl \
    --http1.1 \
    --fail \
    --location \
    --retry 5 \
    --retry-all-errors \
    --retry-delay 2 \
    --connect-timeout 15 \
    --max-time 300 \
    -o "${PROTOC_TMP}" \
    "${GITHUB_PROXY_PRIMARY}${PROTOC_URL}" \
    || \
    curl \
    --http1.1 \
    --fail \
    --location \
    --retry 5 \
    --retry-all-errors \
    --retry-delay 2 \
    --connect-timeout 15 \
    --max-time 300 \
    -o "${PROTOC_TMP}" \
    "${GITHUB_PROXY_FALLBACK}${PROTOC_URL}" \
    || \
    curl \
    --http1.1 \
    --fail \
    --location \
    --retry 3 \
    --retry-all-errors \
    --retry-delay 2 \
    --connect-timeout 15 \
    --max-time 300 \
    -o "${PROTOC_TMP}" \
    "${PROTOC_URL}"; \
    fi; \
    \
    echo "安装 protoc..."; \
    unzip -o "${PROTOC_TMP}" -d /usr/local; \
    chmod +x /usr/local/bin/protoc; \
    rm -f "${PROTOC_TMP}"; \
    \
    echo "protoc 安装完成："; \
    protoc --version


# =========================
# Python 依赖
# =========================

COPY docreader/pyproject.toml docreader/uv.lock ./

ENV UV_DEFAULT_INDEX="https://mirrors.aliyun.com/pypi/simple"

RUN python -m pip install \
    --break-system-packages \
    --no-cache-dir \
    --index-url "${PYPI_MIRROR}" \
    uv && \
    uv --version && \
    python -m uv sync \
    --locked \
    --no-dev


# =========================
# 复制源代码和生成脚本
# =========================

COPY docreader docreader


# =========================
# 生成 protobuf 代码
# =========================

ENV PATH="/app/.venv/bin:${PATH}"

RUN chmod +x docreader/scripts/generate_proto.sh && \
    bash docreader/scripts/generate_proto.sh



# ============================================================
# 运行阶段
# ============================================================

FROM python:3.10.18-bookworm AS runner

ARG APT_MIRROR=""
ARG PYPI_MIRROR="https://mirrors.aliyun.com/pypi/simple"

ARG GITHUB_PROXY_PRIMARY="https://githubproxy.cc/"
ARG GITHUB_PROXY_FALLBACK="https://ghfast.top/"

ARG PLAYWRIGHT_DOWNLOAD_HOST="https://npmmirror.com/mirrors/playwright"


RUN if [ -n "$APT_MIRROR" ]; then \
    sed -i "s@http://deb.debian.org@${APT_MIRROR}@g" \
    /etc/apt/sources.list.d/debian.sources && \
    sed -i "s@http://security.debian.org@${APT_MIRROR}@g" \
    /etc/apt/sources.list.d/debian.sources; \
    fi


WORKDIR /app


# =========================
# 安装运行时依赖
# =========================

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libjpeg62-turbo \
    wget \
    gnupg \
    openjdk-17-jre-headless \
    libgl1 \
    libglib2.0-0 \
    antiword \
    tar \
    dpkg \
    libxinerama1 \
    libfontconfig1 \
    libdbus-glib-1-2 \
    libcairo2 \
    libcups2 \
    libglu1-mesa \
    libsm6 \
    libreoffice \
    curl \
    ca-certificates && \
    rm -rf /var/lib/apt/lists/*


# =========================
# 安装 grpc_health_probe
#
# 支持本地离线包：
#
# packages/grpc_health_probe-linux-amd64
# packages/grpc_health_probe-linux-arm64
# =========================

ARG TARGETARCH

COPY packages/ /app/packages/


RUN set -eux; \
    \
    if [ -z "${TARGETARCH:-}" ]; then \
    case "$(uname -m)" in \
    "x86_64") \
    TARGETARCH="amd64" \
    ;; \
    "aarch64") \
    TARGETARCH="arm64" \
    ;; \
    "armv7l") \
    TARGETARCH="arm" \
    ;; \
    *) \
    echo "Unsupported architecture: $(uname -m)"; \
    exit 1 \
    ;; \
    esac; \
    echo "[自动检测] 架构: ${TARGETARCH}"; \
    else \
    echo "[BuildKit] 架构: ${TARGETARCH}"; \
    fi; \
    \
    case "${TARGETARCH}" in \
    "amd64") \
    ARCH="amd64" \
    ;; \
    "arm64") \
    ARCH="arm64" \
    ;; \
    "arm") \
    ARCH="arm" \
    ;; \
    *) \
    echo "Unsupported architecture: ${TARGETARCH}"; \
    exit 1 \
    ;; \
    esac; \
    \
    GRPC_HEALTH_PROBE_VERSION="v0.4.24"; \
    GRPC_HEALTH_PROBE_PACKAGE="grpc_health_probe-linux-${ARCH}"; \
    GRPC_HEALTH_PROBE_LOCAL="/app/packages/${GRPC_HEALTH_PROBE_PACKAGE}"; \
    GRPC_HEALTH_PROBE_URL="https://github.com/grpc-ecosystem/grpc-health-probe/releases/download/${GRPC_HEALTH_PROBE_VERSION}/${GRPC_HEALTH_PROBE_PACKAGE}"; \
    \
    if [ -f "${GRPC_HEALTH_PROBE_LOCAL}" ]; then \
    \
    echo "============================================"; \
    echo "发现本地 grpc_health_probe"; \
    echo "${GRPC_HEALTH_PROBE_LOCAL}"; \
    echo "使用离线安装"; \
    echo "============================================"; \
    \
    cp "${GRPC_HEALTH_PROBE_LOCAL}" /bin/grpc_health_probe; \
    else \
    \
    echo "============================================"; \
    echo "未发现本地 grpc_health_probe"; \
    echo "开始从国内 GitHub 代理下载"; \
    echo "============================================"; \
    \
    curl \
    --http1.1 \
    --fail \
    --location \
    --retry 5 \
    --retry-all-errors \
    --retry-delay 2 \
    --connect-timeout 15 \
    --max-time 300 \
    -o /bin/grpc_health_probe \
    "${GITHUB_PROXY_PRIMARY}${GRPC_HEALTH_PROBE_URL}" \
    || \
    curl \
    --http1.1 \
    --fail \
    --location \
    --retry 5 \
    --retry-all-errors \
    --retry-delay 2 \
    --connect-timeout 15 \
    --max-time 300 \
    -o /bin/grpc_health_probe \
    "${GITHUB_PROXY_FALLBACK}${GRPC_HEALTH_PROBE_URL}" \
    || \
    curl \
    --http1.1 \
    --fail \
    --location \
    --retry 3 \
    --retry-all-errors \
    --retry-delay 2 \
    --connect-timeout 15 \
    --max-time 300 \
    -o /bin/grpc_health_probe \
    "${GRPC_HEALTH_PROBE_URL}"; \
    fi; \
    \
    chmod +x /bin/grpc_health_probe; \
    \
    echo "grpc_health_probe 安装完成"; \
    /bin/grpc_health_probe --version || true


# =========================
# 从构建阶段复制 Python 虚拟环境
# =========================

ENV VIRTUAL_ENV=/app/.venv

COPY --from=builder ${VIRTUAL_ENV} ${VIRTUAL_ENV}

ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"


# 原项目需要的 /usr/local/bin 内容
COPY --from=builder /usr/local/bin /usr/local/bin


# =========================
# Playwright 国内镜像
# =========================

ENV PLAYWRIGHT_DOWNLOAD_HOST="${PLAYWRIGHT_DOWNLOAD_HOST}"

RUN echo "Playwright download host: ${PLAYWRIGHT_DOWNLOAD_HOST}" && \
    python -m playwright install webkit


# Playwright 系统依赖
# apt 已经替换为国内 Debian 镜像
RUN python -m playwright install-deps webkit


# =========================
# 复制项目
# =========================

COPY docreader/pyproject.toml docreader/uv.lock ./

COPY --from=builder /app/docreader docreader


# =========================
# 创建临时目录
# =========================

RUN mkdir -p /tmp/docreader && \
    rm -rf /app/packages


# =========================
# gRPC
# =========================

EXPOSE 50051


# Probe ARM crypto instructions before importing native dependencies.
# The entrypoint only enables portable OpenSSL implementations after a SIGILL.
ENTRYPOINT ["/app/.venv/bin/python", "-m", "docreader.container_entrypoint"]
CMD ["/app/.venv/bin/python", "-m", "docreader.main"]